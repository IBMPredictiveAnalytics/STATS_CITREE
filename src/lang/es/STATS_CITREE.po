msgstr "No hay ningún árbol de estimación ni archivo de modelo"

#: STATS_CITREE.R:522
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to print are "
"ignored "
msgstr ""
"Sólo hay %s árboles. Se ignoran los nodos de numeración superior para los "
"que se solicita la impresión "

#: STATS_CITREE.R:552
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to plot are ignored"
" "
msgstr ""
"Sólo hay %s árboles. Se ignoran los nodos de numeración superior para los "
"que se solicita el gráfico "

