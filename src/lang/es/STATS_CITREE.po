#: STATS_CITREE.R:82
msgid "End of procedure"
msgstr "Fin del procedimiento"

#: STATS_CITREE.R:111
msgid "Message Number"
msgstr "Número de mensaje"

#: STATS_CITREE.R:145
#, c-format
msgid "Invalid variable name!!!: %s"
msgstr "Nombre de variable no válido: %s"

#: STATS_CITREE.R:174 STATS_CITREE.R:314
msgid "Conditional Inference Trees"
msgstr "Árboles de inferencia condicional"

#: STATS_CITREE.R:175
msgid "Inference Trees Warnings"
msgstr "Avisos de los arboles de inferencia"

#: STATS_CITREE.R:219
msgid "No tree is available for use in prediction"
msgstr "No hay ningún árbol disponible para la predicción"

#: STATS_CITREE.R:224
#, c-format
msgid "workspace restored from %s"
msgstr "espacio de trabajo restaurado a partir de %s"

#: STATS_CITREE.R:235
msgid "Dependent and independent variables must be specified if estimating"
msgstr ""
"Si se realizan estimaciones, deben especificarse las variables dependientes "
"e independientes"

#: STATS_CITREE.R:240
msgid "Cannot specify a model file while action is estimate"
msgstr ""
"No se puede especificar un archivo de modelo si la acción es una estimación"

#: STATS_CITREE.R:249
msgid "A  model source must be specified"
msgstr "Debe especificarse una origen de modelo"

#: STATS_CITREE.R:252
msgid ""
"A model file cannot be saved, because no model has been estimated or loaded"
msgstr ""
"No se puede guardar un archivo de modelo porque no se ha estimado o cargado "
"ningún modelo"

#: STATS_CITREE.R:256
msgid "A dataset must be specified if making predictions"
msgstr ""
"Si se hacen predicciones, es necesario especificar un conjunto de datos"

#: STATS_CITREE.R:260
msgid "If predicting, a model source must be specified"
msgstr "Si se realizan predicciones, debe especificarse un origen de modelo"

#: STATS_CITREE.R:266
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr ""
"El conjunto de datos de predicción especificado ya existe.  Ciérrelo o elija"
" otro nombre"

#: STATS_CITREE.R:270
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr ""
"Si se realizan predicciones, el conjunto de datos de entrada debe tener un "
"nombre.  Asigne uno y vuelva a ejecutar el procedimiento."

#: STATS_CITREE.R:286
#, c-format
msgid "The specified file does not contain a tree model: %s"
msgstr "El archivo especificado no contiene un modelo de árbol: %s"

#: STATS_CITREE.R:299
msgid "An id variable must be specified if making predictions"
msgstr "Si se hacen predicciones, debe especificarse una variable id"

#: STATS_CITREE.R:302
msgid "No model is estimated or loaded from a file"
msgstr "No se ha estimado ningún modelo ni se ha cargado desde un archivo"

#: STATS_CITREE.R:306
msgid ""
"Regression variables are only for model-based recursive partitioning (MOB) "
"models"
msgstr ""
"Las variables de regresión son sólo para modelos de particionamiento "
"recursivo basado en modelos (MOB)"

#: STATS_CITREE.R:329
msgid "Split files is not supported by this procedure"
msgstr "Este procedimiento no permite archivos segmentados"

#: STATS_CITREE.R:332
msgid ""
"at least one dependent variable appears in the independent or regression "
"variable list"
msgstr ""
"Aparece al menos una variable dependiente en la lista de variables "
"independientes o de regresión"

#: STATS_CITREE.R:364
msgid "error fetching data"
msgstr "error al obtener los datos"

#: STATS_CITREE.R:381
msgid ""
"The weight variable must have a scale measurement level to use this "
"procedure."
msgstr ""
"Para utilizar este procedimiento, la variable de ponderación debe tener un "
"nivel de medición de escala."

#: STATS_CITREE.R:392
msgid "Model was estimated with case weights, but dataset is not"
msgstr ""
"El modelo se ha estimado con ponderaciones de casos, pero el conjunto de "
"datos no"

#: STATS_CITREE.R:398
#, c-format
msgid "Computed by the R partykit package, version %s"
msgstr "Calculado por el paquete R partykit, versión %s"

#: STATS_CITREE.R:406
msgid "Dependent or independent variable specification missing"
msgstr "Falta la especificación de la variable dependiente o independiente"

#: STATS_CITREE.R:477
msgid "error estimating tree"
msgstr "error de estimación de árbol"

#: STATS_CITREE.R:485
msgid "There is no model file to save"
msgstr "No hay ningún archivo de modelo para guardar"

#: STATS_CITREE.R:509
