#: STATS_CITREE.R:82
msgid "End of procedure"
msgstr "手順の終わり"

#: STATS_CITREE.R:111
msgid "Message Number"
msgstr "メッセージ番号"

#: STATS_CITREE.R:145
#, c-format
msgid "Invalid variable name!!!: %s"
msgstr "無効な変数名です!!!: %s"

#: STATS_CITREE.R:174 STATS_CITREE.R:314
msgid "Conditional Inference Trees"
msgstr "条件付き推論ツリー"

#: STATS_CITREE.R:175
msgid "Inference Trees Warnings"
msgstr "推論ツリー 警告"

#: STATS_CITREE.R:219
msgid "No tree is available for use in prediction"
msgstr "予測に使用できるツリーがありません"

#: STATS_CITREE.R:224
#, c-format
msgid "workspace restored from %s"
msgstr "ワークスペースが%sから復元されました"

#: STATS_CITREE.R:235
msgid "Dependent and independent variables must be specified if estimating"
msgstr "推定する場合は従属変数と独立変数を指定する必要があります"

#: STATS_CITREE.R:240
msgid "Cannot specify a model file while action is estimate"
msgstr "アクションの推定中にモデル・ファイルを指定できません"

#: STATS_CITREE.R:249
msgid "A  model source must be specified"
msgstr "モデル・ソースを指定する必要があります"

#: STATS_CITREE.R:252
msgid ""
"A model file cannot be saved, because no model has been estimated or loaded"
msgstr "モデルが推定またはロードされていないため、モデル・ファイルを保存できません"

#: STATS_CITREE.R:256
msgid "A dataset must be specified if making predictions"
msgstr "予測を行う場合はデータセットを指定する必要があります"

#: STATS_CITREE.R:260
msgid "If predicting, a model source must be specified"
msgstr "予測する場合は、モデル・ソースを指定する必要があります"

#: STATS_CITREE.R:266
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr "指定された予測データ・セットはすでに存在しています。  データ・セットを閉じるか、別の名前を選択してください"

#: STATS_CITREE.R:270
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr "予測を行うには、入力データ・セットに名前を付ける必要があります。  名前を割り当ててから、手順を再実行してください。"

#: STATS_CITREE.R:286
#, c-format
msgid "The specified file does not contain a tree model: %s"
msgstr "指定されたファイルにはツリー・モデルが含まれていません: %s"

#: STATS_CITREE.R:299
msgid "An id variable must be specified if making predictions"
msgstr "予測を行う際にはID変数を指定する必要があります"

#: STATS_CITREE.R:302
msgid "No model is estimated or loaded from a file"
msgstr "モデルは推定されず、ファイルからロードされません"

#: STATS_CITREE.R:306
msgid ""
"Regression variables are only for model-based recursive partitioning (MOB) "
"models"
msgstr "回帰変数はモデル・ベースの再帰分割(MOB)モデルにのみ使用できます"

#: STATS_CITREE.R:329
msgid "Split files is not supported by this procedure"
msgstr "この手順では、ファイルの分割はサポートされていません"

#: STATS_CITREE.R:332
msgid ""
"at least one dependent variable appears in the independent or regression "
"variable list"
msgstr "独立変数または回帰変数リストに、少なくとも1つの従属変数が表示されます"

#: STATS_CITREE.R:364
msgid "error fetching data"
msgstr "データの取得時にエラーが発生しました"

#: STATS_CITREE.R:381
msgid ""
"The weight variable must have a scale measurement level to use this "
"procedure."
msgstr "この手順を使用するには、重量変数にスケール測定レベルが必要です。"

#: STATS_CITREE.R:392
msgid "Model was estimated with case weights, but dataset is not"
msgstr "モデルはケースの重みで推定されたが、データセットはされません"

#: STATS_CITREE.R:398
#, c-format
msgid "Computed by the R partykit package, version %s"
msgstr "R partykitパッケージ、バージョン%sによって計算されました"

#: STATS_CITREE.R:406
msgid "Dependent or independent variable specification missing"
msgstr "従属変数または独立変数の指定が欠落しています"

#: STATS_CITREE.R:477
msgid "error estimating tree"
msgstr "エラー推定ツリー"

