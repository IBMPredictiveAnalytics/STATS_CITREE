msgid "Node"
msgstr "노드"

#: STATS_CITREE.R:1538 STATS_CITREE.R:1541
msgid "Percent of Cases"
msgstr "케이스 중 %"

#: STATS_CITREE.R:1539 STATS_CITREE.R:1542
msgid "Mode"
msgstr "최빈값(D)"

#: STATS_CITREE.R:1539
msgid "Mean"
msgstr "평균"

#: STATS_CITREE.R:1542
msgid "Percent at Mode"
msgstr "모드에서 백분율"

#: STATS_CITREE.R:1551
#, c-format
msgid "Terminal Node Statistics: %s"
msgstr "터미널 노드 통계: %s"

#: STATS_CITREE.R:1552
msgid "Statistics"
msgstr "통계"

#: STATS_CITREE.R:1557
msgid "Even if there are multiple modes, only one is shown per node"
msgstr "여러 모드가 있더라도 각 노드에는 하나만 표시됩니다."

#: STATS_CITREE.R:1662
msgid "Node Path"
msgstr "노드 경로"

#: STATS_CITREE.R:1786
#, c-format
