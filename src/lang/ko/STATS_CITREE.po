#: STATS_CITREE.R:82
msgid "End of procedure"
msgstr "프로시저 끝"

#: STATS_CITREE.R:111
msgid "Message Number"
msgstr "메시지 번호"

#: STATS_CITREE.R:145
#, c-format
msgid "Invalid variable name!!!: %s"
msgstr "잘못된 변수 이름입니다!!!: %s"

#: STATS_CITREE.R:174 STATS_CITREE.R:314
msgid "Conditional Inference Trees"
msgstr "조건부 추론 트리"

#: STATS_CITREE.R:175
msgid "Inference Trees Warnings"
msgstr "추론 트리 경고"

#: STATS_CITREE.R:219
msgid "No tree is available for use in prediction"
msgstr "예측에 사용할 수 있는 트리가 없습니다."

#: STATS_CITREE.R:224
#, c-format
msgid "workspace restored from %s"
msgstr "%s에서 복원된 작업공간"

#: STATS_CITREE.R:235
msgid "Dependent and independent variables must be specified if estimating"
msgstr "추정할 때는 종속 변수와 독립 변수를 반드시 명시해야 합니다."

#: STATS_CITREE.R:240
msgid "Cannot specify a model file while action is estimate"
msgstr "작업이 추정되는 동안 모델 파일을 지정할 수 없습니다."

#: STATS_CITREE.R:249
msgid "A  model source must be specified"
msgstr "모델 소스를 지정해야 합니다."

#: STATS_CITREE.R:252
msgid ""
"A model file cannot be saved, because no model has been estimated or loaded"
msgstr "모델이 추정되거나 로드되지 않았기 때문에 모델 파일을 저장할 수 없습니다."

#: STATS_CITREE.R:256
msgid "A dataset must be specified if making predictions"
msgstr "데이터 세트를 지정해야 합니다."

#: STATS_CITREE.R:260
msgid "If predicting, a model source must be specified"
msgstr "예측을 하는 경우, 모델 소스를 지정해야 합니다."

#: STATS_CITREE.R:266
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr "지정한 예측 데이터 세트가 이미 존재합니다.  닫거나 다른 이름 선택"

#: STATS_CITREE.R:270
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr "예측을 수행하는 경우 입력 데이터 세트에 이름이 있어야 합니다.  하나를 지정하고 프로시저를 다시 실행하십시오."

#: STATS_CITREE.R:286
#, c-format
msgid "The specified file does not contain a tree model: %s"
msgstr "지정된 파일에는 트리 모델이 포함되어 있지 않습니다: %s"

#: STATS_CITREE.R:299
msgid "An id variable must be specified if making predictions"
msgstr "예측을 수행할 때는 ID 변수를 지정해야 합니다."

#: STATS_CITREE.R:302
msgid "No model is estimated or loaded from a file"
msgstr "모델이 파일에서 추정되거나 로드되지 않습니다."

#: STATS_CITREE.R:306
msgid ""
"Regression variables are only for model-based recursive partitioning (MOB) "
"models"
msgstr "회귀 변수는 모델 기반 재귀 파티셔닝(MOB) 모델에만 사용됩니다."

#: STATS_CITREE.R:329
msgid "Split files is not supported by this procedure"
msgstr "이 프로시저에서는 파일 분할이 지원되지 않습니다."

#: STATS_CITREE.R:332
msgid ""
"at least one dependent variable appears in the independent or regression "
"variable list"
msgstr "독립 변수 또는 회귀 변수 목록에 하나 이상의 종속 변수가 포함되어 있습니다."

#: STATS_CITREE.R:364
msgid "error fetching data"
msgstr "데이터 페치 중 오류 발생"

#: STATS_CITREE.R:381
msgid ""
"The weight variable must have a scale measurement level to use this "
"procedure."
msgstr "이 절차를 사용하려면 무게 변수는 척도 측정 수준을 가져야 합니다."

#: STATS_CITREE.R:392
msgid "Model was estimated with case weights, but dataset is not"
msgstr "모델은 케이스 가중치를 사용하여 추정되었지만 데이터 세트는 그렇지 않습니다."

#: STATS_CITREE.R:398
#, c-format
msgid "Computed by the R partykit package, version %s"
msgstr "R 파티키트 패키지로 계산됨, 버전 %s"

#: STATS_CITREE.R:406
msgid "Dependent or independent variable specification missing"
msgstr "종속 변수 또는 독립 변수의 명시가 누락되었습니다."

#: STATS_CITREE.R:477
msgid "error estimating tree"
msgstr "오류 추정 트리"

#: STATS_CITREE.R:485
msgid "There is no model file to save"
msgstr "저장할 모델 파일이 없습니다"

#: STATS_CITREE.R:509
msgid "There is no tree from estimation or a model file"
msgstr "추정치나 모델 파일에서 트리가 없습니다."

#: STATS_CITREE.R:522
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to print are "
"ignored "
msgstr "%s 트리만 있습니다. 노드 번호가 높은 경우 인쇄 요청이 무시됩니다. "

#: STATS_CITREE.R:552
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to plot are ignored"
" "
msgstr "%s 트리만 있습니다. 요청된 플롯에서 번호가 높은 노드는 무시됩니다. "

#: STATS_CITREE.R:629
msgid "Invalid combination of testtype parameters"
msgstr "잘못된 테스트 유형 매개변수 조합입니다."

