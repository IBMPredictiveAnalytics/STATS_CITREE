msgstr "혼동 행렬 - %s"

#: STATS_CITREE.R:1457
msgid "Observed"
msgstr "관측빈도"

#: STATS_CITREE.R:1457
msgid "Predicted"
msgstr "예측됨"

#: STATS_CITREE.R:1532
msgid "Node summary table is not available"
msgstr "노드 요약 테이블을 사용할 수 없습니다."

