#: STATS_CITREE.R:82
msgid "End of procedure"
msgstr "Fine della procedura"

#: STATS_CITREE.R:111
msgid "Message Number"
msgstr "Numero messaggio"

#: STATS_CITREE.R:145
#, c-format
msgid "Invalid variable name!!!: %s"
msgstr "Nome variabile non valido!!!: %s"

#: STATS_CITREE.R:174 STATS_CITREE.R:314
msgid "Conditional Inference Trees"
msgstr "Alberi di inferenza condizionale"

#: STATS_CITREE.R:175
msgid "Inference Trees Warnings"
msgstr "Alberi di inferenza Avvertenze"

#: STATS_CITREE.R:219
msgid "No tree is available for use in prediction"
msgstr "Non è disponibile nessun albero da utilizzare per la previsione"

#: STATS_CITREE.R:224
#, c-format
msgid "workspace restored from %s"
msgstr "spazio di lavoro ripristinato da %s"

#: STATS_CITREE.R:235
msgid "Dependent and independent variables must be specified if estimating"
msgstr ""
"Le variabili dipendenti e indipendenti devono essere specificate se si "
"effettuano stime"

#: STATS_CITREE.R:240
msgid "Cannot specify a model file while action is estimate"
msgstr ""
"Non è possibile specificare un file di modello mentre l'azione è in fase di "
"stima"

#: STATS_CITREE.R:249
msgid "A  model source must be specified"
msgstr "È necessario specificare un'origine del modello"

#: STATS_CITREE.R:252
msgid ""
"A model file cannot be saved, because no model has been estimated or loaded"
msgstr ""
"Non è possibile salvare un file di modello perché non è stato stimato né "
"caricato alcun modello"

#: STATS_CITREE.R:256
msgid "A dataset must be specified if making predictions"
msgstr "È necessario specificare un set di dati per effettuare previsioni"

#: STATS_CITREE.R:260
msgid "If predicting, a model source must be specified"
msgstr ""
"Se si effettua una previsione, è necessario specificare un'origine del "
"modello"

#: STATS_CITREE.R:266
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr ""
"Il set di dati di previsione specificato esiste già.  Chiuderlo oppure "
"scegliere un altro nome"

#: STATS_CITREE.R:270
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr ""
"Il set di dati di input deve avere un nome se si effettuano previsioni.  "
"Assegnarne uno e ripetere la procedura."

#: STATS_CITREE.R:286
#, c-format
msgid "The specified file does not contain a tree model: %s"
msgstr "Il file specificato non contiene un modello ad albero: %s"

#: STATS_CITREE.R:299
msgid "An id variable must be specified if making predictions"
msgstr "È necessario specificare una variabile ID se si effettuano previsioni"

#: STATS_CITREE.R:302
msgid "No model is estimated or loaded from a file"
msgstr "Nessun modello viene stimato né caricato da un file"

#: STATS_CITREE.R:306
msgid ""
"Regression variables are only for model-based recursive partitioning (MOB) "
"models"
msgstr ""
"Le variabili di regressione sono esclusivamente per i modelli di partizione "
"ricorsiva basati su modelli (MOB)"

#: STATS_CITREE.R:329
msgid "Split files is not supported by this procedure"
msgstr "La suddivisione dei file non è supportata da questa procedura"

#: STATS_CITREE.R:332
msgid ""
"at least one dependent variable appears in the independent or regression "
"variable list"
msgstr ""
"almeno una variabile dipendente compare nell'elenco delle variabili "
"indipendenti o di regressione"

#: STATS_CITREE.R:364
msgid "error fetching data"
msgstr "errore nel richiamo dei dati"

#: STATS_CITREE.R:381
msgid ""
"The weight variable must have a scale measurement level to use this "
"procedure."
msgstr ""
"Per utilizzare questa procedura, la variabile della scala deve avere un "
"livello di misurazione su scala."

#: STATS_CITREE.R:392
msgid "Model was estimated with case weights, but dataset is not"
msgstr ""
"Il modello è stato stimato utilizzando i pesi dei casi, ma il set di dati "
"non è stato utilizzato"

#: STATS_CITREE.R:398
#, c-format
msgid "Computed by the R partykit package, version %s"
msgstr "Calcolato dal pacchetto R partykit, versione %s"

#: STATS_CITREE.R:406
msgid "Dependent or independent variable specification missing"
msgstr ""
"La specifica della variabile dipendente o indipendente risulta mancante"

#: STATS_CITREE.R:477
msgid "error estimating tree"
msgstr "stima ad albero degli errori"

#: STATS_CITREE.R:485
msgid "There is no model file to save"
msgstr "Non esiste un file di modello da salvare"

#: STATS_CITREE.R:509
msgid "There is no tree from estimation or a model file"
msgstr "Non esiste una stima ad albero né un file di modello"

#: STATS_CITREE.R:522
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to print are "
"ignored "
msgstr ""
"Ci sono solo %s alberi. I nodi con numerazione superiore richiesti per la "
"stampa vengono ignorati "

#: STATS_CITREE.R:552
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to plot are ignored"
" "
msgstr ""
"Ci sono solo %s alberi. I nodi con numerazione più alta richiesti per la "
"tracciatura vengono ignorati "

