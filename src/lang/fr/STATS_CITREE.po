#: STATS_CITREE.R:82
msgid "End of procedure"
msgstr "Fin de la procédure"

#: STATS_CITREE.R:111
msgid "Message Number"
msgstr "Numéro de message"

#: STATS_CITREE.R:145
#, c-format
msgid "Invalid variable name!!!: %s"
msgstr "Nom de variable non valide : %s"

#: STATS_CITREE.R:174 STATS_CITREE.R:314
msgid "Conditional Inference Trees"
msgstr "Arbres d'inférence conditionnelle"

#: STATS_CITREE.R:175
msgid "Inference Trees Warnings"
msgstr "Avertissements d'arbres d'inférence"

#: STATS_CITREE.R:219
msgid "No tree is available for use in prediction"
msgstr "Aucun arbre n'est disponible pour la prédiction"

#: STATS_CITREE.R:224
#, c-format
msgid "workspace restored from %s"
msgstr "espace de travail restauré à partir de %s"

#: STATS_CITREE.R:235
msgid "Dependent and independent variables must be specified if estimating"
msgstr ""
"Des variables dépendantes et indépendantes doivent être spécifiées lors de "
"l'estimation."

#: STATS_CITREE.R:240
msgid "Cannot specify a model file while action is estimate"
msgstr ""
"Il est impossible de spécifier un modèle de fichier lorsque l'action est en "
"cours d'estimation."

#: STATS_CITREE.R:249
msgid "A  model source must be specified"
msgstr "Une source de modèle doit être spécifiée."

#: STATS_CITREE.R:252
msgid ""
"A model file cannot be saved, because no model has been estimated or loaded"
msgstr ""
"Un modèle de fichier ne peut pas être enregistré, car aucun modèle n'a été "
"estimé ou chargé."

#: STATS_CITREE.R:256
msgid "A dataset must be specified if making predictions"
msgstr ""
"Un ensemble de données doit être spécifié pour effectuer des prédictions."

#: STATS_CITREE.R:260
msgid "If predicting, a model source must be specified"
msgstr ""
"S'il s'agit d'une prédiction, il est nécessaire de spécifier une source de "
"modèle."

#: STATS_CITREE.R:266
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr ""
"Le jeu de données de prévision spécifié existe déjà.  Fermez-le ou "
"choisissez un nom différent"

#: STATS_CITREE.R:270
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr ""
"Le jeu de données d'entrée doit avoir un nom si vous effectuez des "
"prévisions.  Attribuez-en un, puis relancez la procédure."

#: STATS_CITREE.R:286
#, c-format
msgid "The specified file does not contain a tree model: %s"
msgstr "Le fichier spécifié ne contient pas de modèle d'arbre : %s"

#: STATS_CITREE.R:299
msgid "An id variable must be specified if making predictions"
msgstr ""
"Une variable d'identification doit être spécifiée pour faire des "
"prédictions."

#: STATS_CITREE.R:302
msgid "No model is estimated or loaded from a file"
msgstr "Aucun modèle n'est évalué ni chargé à partir d'un fichier."

#: STATS_CITREE.R:306
msgid ""
"Regression variables are only for model-based recursive partitioning (MOB) "
"models"
msgstr ""
"Les variables de régression ne sont utilisées que pour les modèles MOB de "
"partitionnement récursif basés sur un modèle."

#: STATS_CITREE.R:329
msgid "Split files is not supported by this procedure"
msgstr ""
"Le fractionnement de fichiers n'est pas pris en charge par cette procédure"

#: STATS_CITREE.R:332
msgid ""
"at least one dependent variable appears in the independent or regression "
"variable list"
msgstr ""
"Au moins une variable dépendante apparaît dans la liste des variables "
"indépendantes ou de régression."

#: STATS_CITREE.R:364
msgid "error fetching data"
msgstr "erreur lors de l'extraction des données"

#: STATS_CITREE.R:381
msgid ""
"The weight variable must have a scale measurement level to use this "
"procedure."
msgstr ""
"La variable de pondération doit avoir un niveau de mesure continue pour "
"utiliser cette procédure."

#: STATS_CITREE.R:392
msgid "Model was estimated with case weights, but dataset is not"
msgstr ""
"Le modèle a été estimé avec des pondérations de cas, mais l'ensemble de "
"données n'est pas disponible."

#: STATS_CITREE.R:398
#, c-format
msgid "Computed by the R partykit package, version %s"
msgstr "Calculé par le package R partykit, version  %s "

#: STATS_CITREE.R:406
msgid "Dependent or independent variable specification missing"
msgstr ""
"La spécification de la variable dépendante ou indépendante est manquante."

#: STATS_CITREE.R:477
msgid "error estimating tree"
msgstr "arbre d'estimation des erreurs"

#: STATS_CITREE.R:485
msgid "There is no model file to save"
msgstr "Aucun fichier modèle à enregistrer"

#: STATS_CITREE.R:509
msgid "There is no tree from estimation or a model file"
msgstr "Il n'existe pas d'arbre d'estimation ni de fichier modèle."

#: STATS_CITREE.R:522
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to print are "
"ignored "
msgstr ""
"Il n'existe que %s arbres. Les nœuds dont le numéro est supérieur à celui "
"demandé pour l'impression sont ignorés. "

#: STATS_CITREE.R:552
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to plot are ignored"
" "
msgstr ""
"Il n'existe que %s arbres. Les nœuds dont le numéro est supérieur à celui "
"demandé pour le diagramme sont ignorés. "

