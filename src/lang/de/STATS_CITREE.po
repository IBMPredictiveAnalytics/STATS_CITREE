#: STATS_CITREE.R:82
msgid "End of procedure"
msgstr "Ende der Prozedur"

#: STATS_CITREE.R:111
msgid "Message Number"
msgstr "Nachrichtennummer"

#: STATS_CITREE.R:145
#, c-format
msgid "Invalid variable name!!!: %s"
msgstr "Ungültiger Variablenname: %s"

#: STATS_CITREE.R:174 STATS_CITREE.R:314
msgid "Conditional Inference Trees"
msgstr "Bedingte Inferenzbäume"

#: STATS_CITREE.R:175
msgid "Inference Trees Warnings"
msgstr "Warnungen zu Inferenzbäumen"

#: STATS_CITREE.R:219
msgid "No tree is available for use in prediction"
msgstr "Für die Vorhersage ist kein Baum verfügbar"

#: STATS_CITREE.R:224
#, c-format
msgid "workspace restored from %s"
msgstr "Arbeitsbereich wiederhergestellt aus %s"

#: STATS_CITREE.R:235
msgid "Dependent and independent variables must be specified if estimating"
msgstr ""
"Abhängige und unabhängige Variablen müssen bei der Durchführung einer "
"Schätzung angegeben werden"

#: STATS_CITREE.R:240
msgid "Cannot specify a model file while action is estimate"
msgstr ""
"Es kann keine Modelldatei angegeben werden, während eine Aktion geschätzt "
"wird"

#: STATS_CITREE.R:249
msgid "A  model source must be specified"
msgstr "Eine Modellquelle muss angegeben werden"

#: STATS_CITREE.R:252
msgid ""
"A model file cannot be saved, because no model has been estimated or loaded"
msgstr ""
"Eine Modelldatei kann nicht gespeichert werden, da kein Modell geschätzt "
"oder geladen wurde"

#: STATS_CITREE.R:256
msgid "A dataset must be specified if making predictions"
msgstr "Bei der Erstellung von Vorhersagen muss ein Dataset angegeben werden"

#: STATS_CITREE.R:260
msgid "If predicting, a model source must be specified"
msgstr "Bei der Vorhersage muss eine Modellquelle angegeben werden"

#: STATS_CITREE.R:266
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr ""
"Das angegebene Vorhersagedataset ist bereits vorhanden.  Schließen Sie es "
"oder wählen Sie einen anderen Namen aus"

#: STATS_CITREE.R:270
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr ""
"Das Eingabedataset muss einen Namen haben, wenn Vorhersagen mit ihm "
"durchgeführt werden.  Weisen Sie ihm einen Namen zu und führen Sie das "
"Verfahren erneut aus."

#: STATS_CITREE.R:286
#, c-format
msgid "The specified file does not contain a tree model: %s"
msgstr "Die angegebene Datei enthält kein Baummodell: %s"

#: STATS_CITREE.R:299
msgid "An id variable must be specified if making predictions"
msgstr ""
"Eine ID-Variable muss angegeben werden, wenn Vorhersagen gemacht werden"

#: STATS_CITREE.R:302
msgid "No model is estimated or loaded from a file"
msgstr "Es wird kein Modell geschätzt oder aus einer Datei geladen"

#: STATS_CITREE.R:306
msgid ""
"Regression variables are only for model-based recursive partitioning (MOB) "
"models"
msgstr ""
"Regressionsvariablen werden nur für Modelle zur modellbasierten rekursiven "
"Partitionierung (MOB) verwendet"

#: STATS_CITREE.R:329
msgid "Split files is not supported by this procedure"
msgstr "Das Teilen von Dateien wird von diesem Verfahren nicht unterstützt"

#: STATS_CITREE.R:332
msgid ""
"at least one dependent variable appears in the independent or regression "
"variable list"
msgstr ""
"mindestens eine abhängige Variable erscheint in der Liste der unabhängigen "
"Variablen oder Regressionsvariablen"

#: STATS_CITREE.R:364
msgid "error fetching data"
msgstr "Fehler beim Abrufen von Daten"

#: STATS_CITREE.R:381
msgid ""
"The weight variable must have a scale measurement level to use this "
"procedure."
msgstr ""
"Für die Verwendung dieser Prozedur muss die Gewichtungsvariable ein "
"metrisches Messniveau aufweisen."

#: STATS_CITREE.R:392
msgid "Model was estimated with case weights, but dataset is not"
msgstr ""
"Das Modell wurde mit einer Fallgewichtung geschätzt, das Dataset aber nicht"

#: STATS_CITREE.R:398
#, c-format
msgid "Computed by the R partykit package, version %s"
msgstr "Berechnet mit dem R-Partykit-Paket, Version %s"

#: STATS_CITREE.R:406
msgid "Dependent or independent variable specification missing"
msgstr "Spezifikation für abhängige oder unabhängige Variable fehlt"

#: STATS_CITREE.R:477
msgid "error estimating tree"
msgstr "Fehler beim Schätzen des Baums"

#: STATS_CITREE.R:485
msgid "There is no model file to save"
msgstr "Es ist keine Modelldatei zum Speichern vorhanden"

#: STATS_CITREE.R:509
msgid "There is no tree from estimation or a model file"
msgstr "Es ist kein Baum aus einer Schätzung oder Modelldatei vorhanden"

#: STATS_CITREE.R:522
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to print are "
"ignored "
msgstr ""
"Es gibt nur %s Bäume. Knoten mit höheren Nummern mit einer Druckaufforderung"
" werden ignoriert "

#: STATS_CITREE.R:552
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to plot are ignored"
" "
msgstr ""
"Es gibt nur %s Bäume. Knoten mit höheren Nummern mit einer Aufforderung zur "
"grafischen Darstellung werden ignoriert "

