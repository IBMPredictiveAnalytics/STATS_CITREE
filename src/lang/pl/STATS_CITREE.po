#: STATS_CITREE.R:82
msgid "End of procedure"
msgstr "Koniec procedury"

#: STATS_CITREE.R:111
msgid "Message Number"
msgstr "Numer komunikatu"

#: STATS_CITREE.R:145
#, c-format
msgid "Invalid variable name!!!: %s"
msgstr "Niepoprawna nazwa zmiennej: %s"

#: STATS_CITREE.R:174 STATS_CITREE.R:314
msgid "Conditional Inference Trees"
msgstr "Drzewa wnioskowania warunkowego"

#: STATS_CITREE.R:175
msgid "Inference Trees Warnings"
msgstr "Ostrzeżenia drzew wnioskowania"

#: STATS_CITREE.R:219
msgid "No tree is available for use in prediction"
msgstr "Żadne drzewo nie jest dostępne do użycia przy tworzeniu predykcji"

#: STATS_CITREE.R:224
#, c-format
msgid "workspace restored from %s"
msgstr "obszar roboczy został przywrócony z %s"

#: STATS_CITREE.R:235
msgid "Dependent and independent variables must be specified if estimating"
msgstr "Podczas szacowania należy określić zmienne zależne i niezależne"

#: STATS_CITREE.R:240
msgid "Cannot specify a model file while action is estimate"
msgstr ""
"Nie można określić pliku modelu podczas wykonywania działania szacowania"

#: STATS_CITREE.R:249
msgid "A  model source must be specified"
msgstr "Należy określić źródło modelu"

#: STATS_CITREE.R:252
msgid ""
"A model file cannot be saved, because no model has been estimated or loaded"
msgstr ""
"Nie można zapisać pliku modelu, ponieważ żaden model nie został oszacowany "
"albo załadowany"

#: STATS_CITREE.R:256
msgid "A dataset must be specified if making predictions"
msgstr "Aby tworzyć predykcje, należy określić zestaw danych"

#: STATS_CITREE.R:260
msgid "If predicting, a model source must be specified"
msgstr "W przypadku przewidywania należy określić źródło modelu"

#: STATS_CITREE.R:266
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr ""
"Określony zestaw danych predykcji już istnieje.  Zamknij go lub wybierz inną"
" nazwę"

#: STATS_CITREE.R:270
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr ""
"W przypadku prognozy wejściowy zestaw danych musi mieć nazwę.  Przypisz ją i"
" uruchom procedurę ponownie."

#: STATS_CITREE.R:286
#, c-format
msgid "The specified file does not contain a tree model: %s"
msgstr "Podany plik nie zawiera modelu drzewa: %s"

#: STATS_CITREE.R:299
msgid "An id variable must be specified if making predictions"
msgstr "Należy określić zmienną id, aby tworzyć predykcje"

#: STATS_CITREE.R:302
msgid "No model is estimated or loaded from a file"
msgstr "Żaden model nie został oszacowany ani załadowany z pliku"

#: STATS_CITREE.R:306
msgid ""
"Regression variables are only for model-based recursive partitioning (MOB) "
"models"
msgstr ""
"Zmienne regresji są przeznaczone wyłącznie dla modeli bazujących na "
"rekurencyjnym partycjonowaniu (MOB)"

#: STATS_CITREE.R:329
msgid "Split files is not supported by this procedure"
msgstr "Ta procedura nie obsługuje dzielenia plików"

#: STATS_CITREE.R:332
msgid ""
"at least one dependent variable appears in the independent or regression "
"variable list"
msgstr ""
"przynajmniej jedna zmienna zależna pojawia się na liście zmiennych "
"niezależnych lub regresji"

#: STATS_CITREE.R:364
msgid "error fetching data"
msgstr "błąd pobierania danych"

#: STATS_CITREE.R:381
msgid ""
"The weight variable must have a scale measurement level to use this "
"procedure."
msgstr ""
"Aby użyć tej procedury, zmienna wagi musi mieć poziom pomiaru ilościowego."

#: STATS_CITREE.R:392
msgid "Model was estimated with case weights, but dataset is not"
msgstr "Model został oszacowany z wagami przypadków, ale zbiór danych nie"

#: STATS_CITREE.R:398
#, c-format
msgid "Computed by the R partykit package, version %s"
msgstr "Obliczone przez pakiet R partykit, wersja %s"

#: STATS_CITREE.R:406
msgid "Dependent or independent variable specification missing"
msgstr "Brak specyfikacji zmiennej zależnej lub niezależnej"

#: STATS_CITREE.R:477
msgid "error estimating tree"
msgstr "błąd podczas szacowania drzewa"

#: STATS_CITREE.R:485
msgid "There is no model file to save"
msgstr "Nie ma pliku modelu do zapisania"

#: STATS_CITREE.R:509
msgid "There is no tree from estimation or a model file"
msgstr "Nie ma drzewa określonego w wyniku szacowania lub pliku modelu"

#: STATS_CITREE.R:522
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to print are "
"ignored "
msgstr ""
"Jest tylko %s drzew. Wyświetlanie węzłów o wyższych numerach jest ignorowane"
" "

#: STATS_CITREE.R:552
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to plot are ignored"
" "
msgstr ""
"Jest tylko %s drzew. Wykreślanie węzłów o wyższych numerach jest ignorowane "

