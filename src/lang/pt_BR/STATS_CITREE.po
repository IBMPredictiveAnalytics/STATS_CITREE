#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to print are "
"ignored "
msgstr ""
"Há apenas %s árvores. Os nós com números mais altos solicitados para "
"impressão são ignorados "

#: STATS_CITREE.R:552
#, c-format
msgid ""
"There are only %s trees. Higher numbered nodes requested to plot are ignored"
" "
msgstr ""
"Há apenas %s árvores. Os nós com números mais altos solicitados para criação"
" de gráfico são ignorados "

