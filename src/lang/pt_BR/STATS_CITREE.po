#: STATS_CITREE.R:82
msgid "End of procedure"
msgstr "Fim do procedimento"

#: STATS_CITREE.R:111
msgid "Message Number"
msgstr "Número da mensagem"

#: STATS_CITREE.R:145
#, c-format
msgid "Invalid variable name!!!: %s"
msgstr "Nome de variável inválido!!!: %s"

#: STATS_CITREE.R:174 STATS_CITREE.R:314
msgid "Conditional Inference Trees"
msgstr "Árvores de inferência condicional"

#: STATS_CITREE.R:175
msgid "Inference Trees Warnings"
msgstr "Avisos de árvores de inferência"

#: STATS_CITREE.R:219
msgid "No tree is available for use in prediction"
msgstr "Nenhuma árvore está disponível para uso em predição"

#: STATS_CITREE.R:224
#, c-format
msgid "workspace restored from %s"
msgstr "área de trabalho restaurada de %s"

#: STATS_CITREE.R:235
msgid "Dependent and independent variables must be specified if estimating"
msgstr ""
"As variáveis dependentes e independentes devem ser especificadas ao fazer "
"uma estimativa"

#: STATS_CITREE.R:240
msgid "Cannot specify a model file while action is estimate"
msgstr ""
"Não é possível especificar um arquivo de modelo enquanto a ação está em "
"processo de estimativa"

#: STATS_CITREE.R:249
msgid "A  model source must be specified"
msgstr "Uma origem de modelo deve ser especificada"

#: STATS_CITREE.R:252
msgid ""
"A model file cannot be saved, because no model has been estimated or loaded"
msgstr ""
"Não é possível salvar um arquivo de modelo, pois nenhum modelo foi estimado "
"ou carregado"

#: STATS_CITREE.R:256
msgid "A dataset must be specified if making predictions"
msgstr "Um conjunto de dados deve ser especificado ao fazer predições"

#: STATS_CITREE.R:260
msgid "If predicting, a model source must be specified"
msgstr ""
"Se estiver fazendo uma predição, deve-se especificar uma origem de modelo"

#: STATS_CITREE.R:266
msgid ""
"The prediction dataset specified already exists.  Please close it or choose "
"a different name"
msgstr ""
"O conjunto de dados de predição especificado já existe.  Feche-o ou escolha "
"um nome diferente"

#: STATS_CITREE.R:270
msgid ""
"The input dataset must have a name if doing predictions.  Please assign one "
"and rerun the procedure."
msgstr ""
"O conjunto de dados de entrada deve ter um nome caso esteja fazendo "
"predições  Designe um e execute novamente o procedimento"

#: STATS_CITREE.R:286
#, c-format
msgid "The specified file does not contain a tree model: %s"
msgstr "O arquivo especificado não contém um modelo de árvore: %s"

#: STATS_CITREE.R:299
msgid "An id variable must be specified if making predictions"
msgstr "Uma variável de ID de deve ser especificada ao fazer predições"

#: STATS_CITREE.R:302
msgid "No model is estimated or loaded from a file"
msgstr "Nenhum modelo foi estimado ou carregado de um arquivo"

#: STATS_CITREE.R:306
msgid ""
"Regression variables are only for model-based recursive partitioning (MOB) "
"models"
msgstr ""
"As variáveis de regressão são exclusivas para modelos de particionamento "
"recursivo baseado em modelo (MOB)"

#: STATS_CITREE.R:329
msgid "Split files is not supported by this procedure"
msgstr "A divisão de arquivos não é suportada por este procedimento"

#: STATS_CITREE.R:332
msgid ""
"at least one dependent variable appears in the independent or regression "
"variable list"
msgstr ""
"pelo menos uma variável dependente aparece na lista de variáveis "
"independentes ou de regressão"

#: STATS_CITREE.R:364
msgid "error fetching data"
msgstr "erro ao buscar dados"

#: STATS_CITREE.R:381
msgid ""
"The weight variable must have a scale measurement level to use this "
"procedure."
msgstr ""
"A variável de ponderação deve ter um nível de medição de escala para usar "
"este procedimento."

#: STATS_CITREE.R:392
msgid "Model was estimated with case weights, but dataset is not"
msgstr "O modelo foi estimado com pesos de casos, mas o conjunto de dados não"

